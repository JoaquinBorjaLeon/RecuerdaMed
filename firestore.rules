rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Comprueba si el usuario autenticado tiene un rol específico
    function isRole(role) {
      return signedIn() && userDoc().data.role == role;
    }

    // Comprueba si el usuario autenticado es el dueño del recurso
    function isOwner(patientId) {
      return signedIn() && request.auth.uid == patientId;
    }

    // Comprueba si el usuario tiene un careLink activo con el paciente
    function isLinkedTo(patientId) {
      return signedIn() &&
        get(
          /databases/$(database)/documents/careLinks/$(request.auth.uid + "_" + patientId)
        ).data.status == "ACTIVE";
    }

    // Obtiene el patientId del medicamento referenciado
    function medOwnerById(medId) {
      return get(/databases/$(database)/documents/medications/$(medId)).data.patientId;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email', 'createdAt']);
    }

    match /careLinks/{careLinkId} {
      allow read: if signedIn() &&
        (
          resource.data.patientId == request.auth.uid ||
          resource.data.caregiverId == request.auth.uid ||
          resource.data.caregiverEmail == request.auth.token.email
        );

      allow create: if signedIn() &&
        (
          // Paciente crea invitación pendiente (sin caregiverId, ID determinista)
          (request.resource.data.patientId == request.auth.uid &&
           request.resource.data.status == "PENDING" &&
           !('caregiverId' in request.resource.data) &&
           careLinkId == (request.resource.data.caregiverEmail + "_" + request.resource.data.patientId)) ||
          // Cuidador/familiar acepta invitación: debe existir una PENDING previa coherente
          (request.resource.data.caregiverId == request.auth.uid &&
           request.resource.data.caregiverEmail == request.auth.token.email &&
           request.resource.data.status == "ACTIVE" &&
           careLinkId == (request.auth.uid + "_" + request.resource.data.patientId) &&
           get(/databases/$(database)/documents/careLinks/$(request.auth.token.email + "_" + request.resource.data.patientId)).data.status == "PENDING" &&
           get(/databases/$(database)/documents/careLinks/$(request.auth.token.email + "_" + request.resource.data.patientId)).data.patientId == request.resource.data.patientId)
        );

      allow update: if signedIn() &&
        (
          resource.data.patientId == request.auth.uid ||
          resource.data.caregiverId == request.auth.uid ||
          resource.data.caregiverEmail == request.auth.token.email
        ) &&
        request.resource.data.status in ["REJECTED", "REMOVED"] &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['patientId', 'caregiverId', 'caregiverEmail']);
    }

    match /medications/{medId} {
      allow read: if
        isOwner(resource.data.patientId) ||
        isLinkedTo(resource.data.patientId);

      allow create: if
        isOwner(request.resource.data.patientId) ||
        (isRole("CAREGIVER") && isLinkedTo(request.resource.data.patientId));

      allow update: if
        (isOwner(resource.data.patientId) ||
        (isRole("CAREGIVER") && isLinkedTo(resource.data.patientId))) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['patientId', 'createdAt', 'createdBy']);

      allow delete: if
        isOwner(resource.data.patientId) ||
        (isRole("CAREGIVER") && isLinkedTo(resource.data.patientId));
    }

    match /schedules/{scheduleId} {
      allow read: if
        isOwner(resource.data.patientId) ||
        isLinkedTo(resource.data.patientId);

      allow create: if
        isOwner(request.resource.data.patientId) ||
        (isRole("CAREGIVER") && isLinkedTo(request.resource.data.patientId));

      allow update: if
        (isOwner(resource.data.patientId) ||
        (isRole("CAREGIVER") && isLinkedTo(resource.data.patientId)) ||
        isOwner(medOwnerById(resource.data.medId))) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['medId', 'patientId', 'createdAt']);

      allow delete: if
        isOwner(resource.data.patientId) ||
        (isRole("CAREGIVER") && isLinkedTo(resource.data.patientId)) ||
        isOwner(medOwnerById(resource.data.medId));
    }

    match /push_tokens/{tokenId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.patientId == request.auth.uid;
      allow delete: if signedIn() &&
        resource.data.patientId == request.auth.uid;
    }

    match /tomas/{tomaId} {
      allow read: if
        isOwner(resource.data.patientId) ||
        isLinkedTo(resource.data.patientId);

      allow create: if
        isOwner(request.resource.data.patientId) ||
        (isRole("CAREGIVER") && isLinkedTo(request.resource.data.patientId));

      allow update: if
        (isOwner(resource.data.patientId) ||
        (isRole("CAREGIVER") && isLinkedTo(resource.data.patientId)) ||
        isOwner(medOwnerById(resource.data.medId))) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['patientId', 'medId', 'scheduleId', 'plannedAt', 'windowStart', 'windowEnd', 'dedupeKey', 'createdAt']);

      allow delete: if
        isOwner(resource.data.patientId) ||
        (isRole("CAREGIVER") && isLinkedTo(resource.data.patientId)) ||
        isOwner(medOwnerById(resource.data.medId));
    }
  }
}
